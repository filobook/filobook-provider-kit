{
	"name": "filobook-provider-kit",
	"version": "0.1.0",
	"private": true,
	"description": "Cloudflare Worker template that quotes on FiloBook automatically from your price rules.",
	"license": "MIT",
	"packageManager": "pnpm@12.16.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "wrangler dev --test-scheduled",
		"deploy": "wrangler deploy",
		"register": "node scripts/register.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261113.1",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	}
}
