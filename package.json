{
	"name": "filobook-provider-kit",
	"version": "0.1.0",
	"private": true,
	"description": "An agnostic worker that quotes on FiloBook orders for you. Runs on Cloudflare Workers, Node, Bun and Deno.",
	"license": "MIT",
	"packageManager": "pnpm@12.16.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/server.mjs",
		"start": "node dist/server.mjs",
		"dev": "wrangler dev --test-scheduled",
		"dev:node": "pnpm build && node dist/server.mjs",
		"deploy": "wrangler deploy",
		"register": "node scripts/register.mjs",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "22.20.5",
		"esbuild": "0.28.2",
		"typescript": "6.0.3",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	}
}
